<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>file-manager-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>file-manager-service</artifactId>
    <packaging>jar</packaging>

    <name>File Manager - Standalone Service</name>
    <description>
        Deployable Spring Boot app: embeds file-manager-spring-boot-starter and exposes it over a
        versioned, Swagger-documented REST API for consumers that don't or can't embed the
        library directly.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            Spring Boot 4 split JSON support out of spring-boot-starter-web (which now stays
            JSON-library-agnostic) - this is what actually registers the ObjectMapper bean
            ApiKeyAuthenticationFilter and SecureAccessWebConfiguration depend on.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            TestRestTemplate lives in its own module as of Spring Boot 4's modularization, and
            itself needs RestTemplateBuilder from spring-boot-restclient (also no longer pulled
            in transitively by spring-boot-starter-web).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test-only: with no spring.datasource.* properties set, Spring Boot's stock
            DataSourceAutoConfiguration auto-configures an embedded in-memory H2 DataSource purely
            from this driver's presence on the test classpath (docs/testing.md) - the same
            zero-config convenience file-manager-spring-boot-starter's own tests rely on. A real
            deployment supplies spring.datasource.* itself; this module makes no production
            database choice.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test-only: FileControllerIntegrationTest proves a real upload/download round-trip
            through an actual StorageBackend (docs/testing.md), not just metadata through the
            database - file-manager-storage-local's own @AutoConfiguration self-registers via its
            module's AutoConfiguration.imports (see LocalStorageAutoConfiguration's javadoc), so
            simply being on the test classpath with the file-manager.storage.backend=local
            property set is enough. Mirrors file-manager-spring-boot-starter's own pom.xml.
        -->
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-storage-local</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>file-manager-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
