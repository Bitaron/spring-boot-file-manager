<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.bitaron</groupId>
    <artifactId>file-manager-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>File Manager (parent)</name>
    <description>
        A multi-tenant, Drive-like hierarchical file-management engine - usable as an embeddable
        Spring Boot library or a standalone REST service - with swappable storage backends.
    </description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <lombok.version>1.18.42</lombok.version>
        <!-- Not part of the Spring Boot BOM - pinned here so every module resolves the same
             version (docs/java-conventions.md's "keep the BOM current" rule extended to the one
             dependency it doesn't manage). -->
        <springdoc-openapi.version>3.1.0</springdoc-openapi.version>
    </properties>

    <modules>
        <module>file-manager-core</module>
        <module>file-manager-storage-api</module>
        <module>file-manager-storage-local</module>
        <module>file-manager-storage-s3</module>
        <module>file-manager-spring-boot-autoconfigure</module>
        <module>file-manager-spring-boot-starter</module>
        <module>file-manager-api</module>
        <module>file-manager-service</module>
        <module>file-manager-test-support</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM - kept current rather than pinning individual Spring dependency versions (ADR 0001) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Sibling modules, so every module can depend on another by artifactId alone -->
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-storage-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-storage-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-storage-s3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bitaron</groupId>
                <artifactId>file-manager-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Available to every module; annotation-only, never forces a runtime dependency -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <!--
                            JDK 23+ no longer auto-discovers annotation processors from the compile
                            classpath (JDK-8306819); every processor a module needs must be listed
                            explicitly here or it silently stops running (e.g. Lombok's
                            @Getter/@NoArgsConstructor et al. stop generating code) - once one
                            processor path is set explicitly, implicit discovery stops entirely for
                            all of them. This is why spring-boot-configuration-processor (declared as
                            a dependency in file-manager-spring-boot-autoconfigure) is listed here
                            too, not just Lombok. Harmless for modules with no
                            @ConfigurationProperties classes to process.
                        -->
                        <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
