<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>file-manager-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>file-manager-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>File Manager - Spring Boot Starter</name>
    <description>
        The single dependency a host application adds to embed file-manager in Embedded Mode.
        Aggregates file-manager-spring-boot-autoconfigure plus the base Spring Boot starter; the
        host additionally adds whichever file-manager-storage-* module it wants on its classpath.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test-only: backs the Embedded Mode integration test's own DataSource bean (a plain
            in-memory H2 database supplied by the test, per docs/testing.md's "boots the Spring
            Boot starter in a plain application context" rule) - not a dependency the autoconfigure
            module needs at compile time.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test-only: the File persistence Embedded Mode integration test proves a real
            upload/download round-trip through an actual StorageBackend (per docs/testing.md), not
            just metadata through the database - file-manager-storage-local's own @AutoConfiguration
            self-registers via its module's AutoConfiguration.imports (see
            LocalStorageAutoConfiguration's javadoc), so simply being on the test classpath with the
            file-manager.storage.backend=local property set is enough.
        -->
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-storage-local</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
