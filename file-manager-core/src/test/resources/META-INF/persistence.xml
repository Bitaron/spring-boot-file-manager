<?xml version="1.0" encoding="UTF-8"?>
<!--
    Test-only persistence unit: a plain JPA bootstrap (Hibernate + in-memory H2), no Spring
    context, proving core's entities and hand-written JPQL/Criteria DAOs work against a real
    EntityManager (docs/testing.md). Production wiring builds an EntityManager from the host's
    own EntityManagerFactory instead (decision #17); this unit exists for file-manager-core's own
    tests only and is never packaged for consumers.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="file-manager-core-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>io.github.bitaron.filemanager.core.tenant.Tenant</class>
        <class>io.github.bitaron.filemanager.core.apikey.ApiKey</class>
        <class>io.github.bitaron.filemanager.core.folder.Folder</class>
        <class>io.github.bitaron.filemanager.core.file.File</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                       value="jdbc:h2:mem:file-manager-core-test;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>
</persistence>
