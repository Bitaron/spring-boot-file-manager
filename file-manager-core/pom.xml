<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>file-manager-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>file-manager-core</artifactId>
    <packaging>jar</packaging>

    <name>File Manager - Core</name>
    <description>
        Domain model and engine: Tenant, Folder, File, Visibility, AccessToken, Trash.
        No Spring Web or transport dependency, so it stays usable from both Embedded Mode
        and the Standalone Service's controllers (see docs/java-conventions.md).
    </description>

    <dependencies>
        <!--
            JPA annotations only (@Entity, @Id, ...) - entities are mapped so they fold into a
            host's entity scan, but core talks to a plain EntityManager via hand-written
            JPQL/Criteria DAOs, never Spring Data JPA repositories (decision #17).
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!--
            The StorageBackend contract (ADR 0002): FileService holds a StorageBackend
            reference and round-trips its opaque storageReference string, never
            interpreting it - no implementation dependency here, just the interface.
        -->
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-storage-api</artifactId>
        </dependency>

        <!--
            Test-only JPA provider + in-memory database: core's own DAO tests need a real
            EntityManager to prove indexed lookups (e.g. ApiKey's key_hash, Folder's
            tenant_id/parent_folder_id) work, without pulling in a Spring context
            (docs/testing.md) or pinning a production database engine.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
