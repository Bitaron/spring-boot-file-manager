<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.bitaron</groupId>
        <artifactId>file-manager-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>file-manager-usage-example</artifactId>
    <packaging>jar</packaging>

    <name>File Manager - Usage Example</name>
    <description>
        Runnable Embedded Mode consumer app (issue #12/#66) - a leaf module nothing else in the
        reactor depends on, and no external consumer ever adds as a dependency (unlike
        file-manager-spring-boot-starter, the thing consumers actually embed). Exists purely as a
        living, compiled reference: walks through the Folder/File calls documented in
        docs/library-usage.md against a real (if throwaway) database and StorageBackend, so those
        docs can't silently drift, and so both a human and an agent doing this integration have a
        runnable example to copy from.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-spring-boot-starter</artifactId>
        </dependency>
        <!--
            Unlike file-manager-service/file-manager-spring-boot-starter (where this is test-only:
            a real deployment supplies its own storage backend/database), this module's whole point
            is to run standalone with zero external setup - so both the local StorageBackend and an
            embedded database driver are main-scope dependencies here, not test-only.
        -->
        <dependency>
            <groupId>io.github.bitaron</groupId>
            <artifactId>file-manager-storage-local</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>file-manager-usage-example</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                    Explicit execution because this reactor's parent isn't spring-boot-starter-parent
                    (which would bind `repackage` to the `package` phase implicitly) - without this,
                    `mvn package`/`install` would produce only the plain, non-executable jar, and
                    issue #12's "packaged as a runnable jar" requirement wouldn't hold.
                -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
